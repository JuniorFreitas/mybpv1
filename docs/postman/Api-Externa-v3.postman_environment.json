{
  "id": "env-api-externa-v3",
  "name": "MyBP API Externa v3 — Local",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "default",
      "enabled": true,
      "description": "Host MyBP sem barra final (local: http://localhost:8000)"
    },
    {
      "key": "client_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Emitido por: php artisan api-externa:credencial {empresa_id}"
    },
    {
      "key": "client_secret",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Mostrado só na criação/rotação — não versionar"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Preenchido automaticamente pelo request Obter token"
    },
    {
      "key": "page",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "per_page",
      "value": "20",
      "type": "default",
      "enabled": true,
      "description": "Máximo 100"
    },
    {
      "key": "mes",
      "value": "10",
      "type": "default",
      "enabled": true,
      "description": "Mês 1–12 para relatório aniversariantes"
    },
    {
      "key": "processo_public_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "curriculo_public_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "cloud_public_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "centro_custo_public_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "empresa_public_id",
      "value": "",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment",
  "_postman_exported_using": "MyBP docs"
}
