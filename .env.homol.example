# Gerado localmente / no CI — NÃO commitar.
# Use: .deploy/generate-env-build.sh homol
# Template: .env.homol.example

APP_NAME="MyBP - Homologação"
APP_URL=https://qa.mybp.com.br

# Preenchidos pelo generate-env-build.sh a partir do SSM (/mybp/prod — keys compartilhadas)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_APP_TLS=true
PUSHER_APP_ENCRYPTED=true
PUSHER_APP_HOST=

MIX_PUSHER_APP_KEY=${PUSHER_APP_KEY}
MIX_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}
MIX_PUSHER_APP_TLS=true
MIX_AMBIENTE=homol
MIX_URL_SITE=${APP_URL}
MIX_URL_ADMIN=${APP_URL}/g
MIX_URL_PUBLICO=${APP_URL}/publico
MIX_GOOGLE_MAPS_KEY=
MIX_TYNEKEY=

NPS_HABILITADO=false
NPS_EMPRESAS_EXCLUIDAS=100
NPS_EMPRESA_GERENCIAMENTO=100
NPS_MIN_ACESSOS_90_DIAS=3
WHATSAPP_MOVIMENTACAO_NOTIFICACOES_HABILITADAS=false
