{
    "private": true,
    "version": "3.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run development",
        "development": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
        "watch": "NODE_OPTIONS=--max-old-space-size=8192 vite build --watch",
        "hot": "vite",
        "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
        "homol": "test -f .env.homol || (echo 'Falta .env.homol — rode: .deploy/generate-env-build.sh homol' && exit 1); FRONTEND_ENV_FILE=.env.homol NODE_OPTIONS=--max-old-space-size=8192 dotenv -e .env.homol -- vite build && node scripts/assert-frontend-bundle-safe.mjs",
        "prod": "test -f .env.prod || (echo 'Falta .env.prod — rode: .deploy/generate-env-build.sh prod' && exit 1); FRONTEND_ENV_FILE=.env.prod NODE_OPTIONS=--max-old-space-size=8192 dotenv -e .env.prod -- vite build && node scripts/assert-frontend-bundle-safe.mjs",
        "production": "NODE_OPTIONS=--max-old-space-size=8192 vite build && node scripts/assert-frontend-bundle-safe.mjs",
        "build:funcoes": "node scripts/build-funcoes.mjs",
        "build:legacy-globals": "node scripts/build-legacy-globals.mjs",
        "build:legacy": "node scripts/build-funcoes.mjs && node scripts/build-legacy-globals.mjs",
        "assert:frontend-safe": "node scripts/assert-frontend-bundle-safe.mjs",
        "test:e2e:whatsapp:login": "PLAYWRIGHT_FORCE_LOGIN=1 playwright test tests/e2e/whatsapp/auth.setup.ts --project=setup",
        "test:e2e:whatsapp": "playwright test tests/e2e/whatsapp --project=whatsapp-chrome",
        "test:e2e:whatsapp:ui": "playwright test tests/e2e/whatsapp --ui",
        "test:e2e:regressao:login": "PLAYWRIGHT_FORCE_LOGIN=1 playwright test tests/e2e/regressao/auth.setup.ts --project=setup",
        "test:e2e:regressao": "playwright test tests/e2e/regressao --project=regressao-chrome",
        "test:e2e:regressao:headed": "PLAYWRIGHT_HEADED=1 playwright test tests/e2e/regressao --project=regressao-chrome",
        "test:e2e:regressao:ui": "playwright test tests/e2e/regressao --ui",
        "test:e2e:plataforma": "playwright test tests/e2e/regressao tests/e2e/whatsapp --project=regressao-chrome --project=whatsapp-chrome"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/compiler-sfc": "^3.5.29",
        "axios": "^1.20.0",
        "bootstrap": "^4.6.2",
        "bootstrap-daterangepicker": "^3.1.0",
        "dotenv": "^16.6.1",
        "dotenv-cli": "^10.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-vue": "^9.22.0",
        "jquery": "^3.7.1",
        "laravel-echo": "^1.15.3",
        "laravel-vite-plugin": "^1.3.0",
        "lodash": "^4.18.1",
        "moment": "^2.31.0",
        "popper.js": "^1.16.1",
        "prettier": "^3.2.5",
        "pusher-js": "^7.6.0",
        "sass": "^1.69.5",
        "toastr": "^2.1.4",
        "vite": "^6.4.1",
        "vite-plugin-static-copy": "^2.3.2",
        "vue": "^3.5.43"
    },
    "dependencies": {
        "@e965/xlsx": "^0.20.3",
        "@googlemaps/js-api-loader": "^1.16.2",
        "@tinymce/tinymce-vue": "^6.3.0",
        "chart.js": "^4.4.4",
        "driver.js": "^0.9.8",
        "leaflet": "^1.9.4",
        "metismenu": "3.0.7",
        "node-waves": "^0.7.6",
        "pdfjs-dist": "^6.4.299",
        "simplebar": "^5.3.9",
        "sweetalert2": "^11.26.17",
        "uuid": "^14.0.2",
        "vue-chartjs": "^5.3.2",
        "vue-multiselect": "^3.4.0",
        "vue-tippy": "^6.7.1",
        "vuedraggable": "^4.1.0"
    }
}
