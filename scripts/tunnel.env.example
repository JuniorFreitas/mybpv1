# Copie para .dev/tunnel.env (gitignored) e ajuste o host.
# Setup: ./scripts/tunnel-named-setup.sh --app devmybp.dynamusti.com.br
#
# CNAME no Cloudflare (proxied):
#   <host> → <TUNNEL_ID>.cfargotunnel.com
#
# Padrão: 1 link (app em localhost:8000 / container mybpdp).

TUNNEL_NAME=devmybp
# TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

TUNNEL_APP_HOST=devmybp.dynamusti.com.br
