#!/bin/bash
set -euo pipefail

# Logs sempre em stderr (line-buffered) — stdout fully-buffered sem TTY sumia no CloudWatch
export PYTHONUNBUFFERED=1
log() { printf '%s\n' "$*" >&2; }

APP_PATH="${APP_PATH:-/usr/share/nginx/html}"
PHP_INI="${php_conf:-/etc/php.ini}"
FPM_POOL_DIR="/etc/php-fpm.d"
FPM_PID_FILE="/run/php-fpm/php-fpm.pid"
FPM_SOCK="/run/php-fpm/www.sock"
CVE_SESSION_UPLOAD_CONF="${APP_PATH}/.deploy/php/fpm-pool.d/zz-cve-2026-115560.conf"
HARDEN_CONF="${APP_PATH}/.deploy/php/fpm-pool.d/zz-mybp-fpm-harden.conf"
IS_ROOT=0
if [ "$(id -u)" -eq 0 ]; then
    IS_ROOT=1
fi

cd "$APP_PATH"

# Configs PHP/FPM já vão no build da imagem. Só sobrescreve /etc se estiver root
# (ex.: volume montando código + override local).
if [ "$IS_ROOT" -eq 1 ]; then
    log " -----> Info: Override php's default config (root)..."
    if [ "${APP_ENV:-local}" = "production" ]; then
        cp "${APP_PATH}/.deploy/php/php.ini-production" "$PHP_INI"
    else
        cp "${APP_PATH}/.deploy/php/php.ini-development" "$PHP_INI"
    fi

    if [ ! -f "$CVE_SESSION_UPLOAD_CONF" ]; then
        log " -----> Error: Missing CVE mitigation conf: ${CVE_SESSION_UPLOAD_CONF}"
        exit 1
    fi
    log " -----> Info: Applying PHP session.upload_progress mitigation..."
    cp "$CVE_SESSION_UPLOAD_CONF" "${FPM_POOL_DIR}/zz-cve-2026-115560.conf"

    WWW_CONF="/etc/php-fpm.d/www.conf"
    FPM_CONF="/etc/php-fpm.conf"
    sed -i 's/^user = apache/user = nginx/' "$WWW_CONF" || true
    sed -i 's/^;group = apache/group = nginx/' "$WWW_CONF" || true
    sed -i 's/^group = apache/group = nginx/' "$WWW_CONF" || true
    sed -i 's/^php_value\[soap\.wsdl_cache_dir\].*/; php_value[soap.wsdl_cache_dir] disabled (ext-soap ausente)/' "$WWW_CONF" || true
    if [ -f "$FPM_CONF" ] && grep -qE '^error_log\s*=' "$FPM_CONF"; then
        sed -i 's#^error_log\s*=.*#error_log = /proc/self/fd/2#' "$FPM_CONF" || true
    fi

    if [ ! -f "$HARDEN_CONF" ]; then
        log " -----> Error: Missing FPM harden conf: ${HARDEN_CONF}"
        exit 1
    fi
    cp "$HARDEN_CONF" "${FPM_POOL_DIR}/zz-mybp-fpm-harden.conf"

    mkdir -p /var/lib/php/session /var/lib/php/wsdlcache /var/lib/php/opcache
    chown -R nginx:nginx /var/lib/php/session /var/lib/php/wsdlcache /var/lib/php/opcache || true
    chmod -R ug+rwX /var/lib/php/session /var/lib/php/wsdlcache /var/lib/php/opcache || true

    if [ -d "${APP_PATH}/storage" ]; then
        log " -----> Info: Fixing permissions on storage..."
        chown -R nginx:nginx storage || true
        chmod -R ug+rwX storage || true
    fi
    if [ -d "${APP_PATH}/bootstrap/cache" ]; then
        log " -----> Info: Fixing permissions on bootstrap/cache..."
        chown -R nginx:nginx bootstrap/cache || true
        chmod -R ug+rwX bootstrap/cache || true
    fi
else
    log " -----> Info: Running as UID $(id -u); using PHP/FPM configs baked in the image."
    mkdir -p /run/php-fpm /tmp /var/cache/nginx \
        "${APP_PATH}/storage/logs" \
        "${APP_PATH}/bootstrap/cache" 2>/dev/null || true
fi

if [ -d "${APP_PATH}/vendor" ]; then
    log " -----> Info: Running migrations..."
    if ! php artisan migrate --force; then
        log " -----> Warning: migrate falhou; mantendo container no ar para debug."
    fi

    log " -----> Info: Running HabilidadesTableSeeder..."
    php artisan db:seed --class=HabilidadesTableSeeder --force || \
        log " -----> Warning: HabilidadesTableSeeder falhou."

    log " -----> Info: Running WhatsappTemplatePadraoSeeder..."
    php artisan db:seed --class=WhatsappTemplatePadraoSeeder --force || \
        log " -----> Warning: WhatsappTemplatePadraoSeeder falhou."

    if [ "${ENABLE_CACHE_APP:-false}" = "true" ]; then
        log " -----> Info: Caching configuration (obrigatório com FPM clear_env=yes)..."
        php artisan package:discover --ansi || true
        if ! php artisan config:cache; then
            log " -----> Error: config:cache falhou; abortando start (sem cache o FPM não vê secrets)."
            exit 1
        fi
    fi
else
    log " -----> Warning: Directory ${APP_PATH}/vendor does not yet exist."
fi

child_pids=()
nginx_pid=""
stopping=0

cleanup() {
    if [ "$stopping" -eq 1 ]; then
        return 0
    fi
    stopping=1
    log " -----> Info: Shutting down..."
    for pid in "${child_pids[@]:-}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done
    if [ -f "$FPM_PID_FILE" ]; then
        fpm_pid="$(cat "$FPM_PID_FILE" 2>/dev/null || true)"
        if [ -n "${fpm_pid:-}" ] && kill -0 "$fpm_pid" 2>/dev/null; then
            kill -TERM "$fpm_pid" 2>/dev/null || true
        fi
    fi
    sleep 1
    for pid in "${child_pids[@]:-}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done
}
trap 'cleanup; exit 143' INT TERM
trap 'cleanup' EXIT

start_bg() {
    local name="$1"
    shift
    log " -----> Info: Starting ${name}..."
    "$@" &
    child_pids+=($!)
}

wait_for_fpm_socket() {
    local sock="${1:-$FPM_SOCK}"
    local tries="${2:-50}"
    local i=0
    log " -----> Info: Waiting for PHP-FPM socket ${sock}..."
    while [ "$i" -lt "$tries" ]; do
        if [ -S "$sock" ]; then
            log " -----> Info: PHP-FPM socket ready."
            return 0
        fi
        i=$((i + 1))
        sleep 0.2
    done
    log " -----> Error: PHP-FPM socket não apareceu: ${sock}"
    return 1
}

fpm_is_alive() {
    if [ -f "$FPM_PID_FILE" ]; then
        local pid
        pid="$(cat "$FPM_PID_FILE" 2>/dev/null || true)"
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    [ -S "$FPM_SOCK" ]
}

if [ "${ENABLE_PHPFPM:-true}" = "true" ]; then
    log " -----> Info: Starting PHP-FPM..."
    mkdir -p /run/php-fpm
    rm -f "$FPM_PID_FILE" "$FPM_SOCK"
    /usr/sbin/php-fpm -F -O --fpm-config=/etc/php-fpm.conf &
    child_pids+=($!)
    wait_for_fpm_socket "$FPM_SOCK" 50
    if ! fpm_is_alive; then
        log " -----> Error: PHP-FPM não ficou vivo após criar o socket."
        exit 1
    fi
fi

if [ "${ENABLE_NGINX:-true}" = "true" ]; then
    log " -----> Info: Starting NGINX..."
    rm -f /var/cache/nginx/nginx.pid
    nginx -t
    /usr/sbin/nginx -g 'daemon off;' &
    nginx_pid=$!
    child_pids+=("$nginx_pid")
fi

if [ "${ENABLE_HORIZON:-false}" = "true" ] && [ -d "${APP_PATH}/vendor" ]; then
    start_bg "Horizon" bash -c 'while true; do php artisan horizon; echo " -----> Warning: Horizon saiu; reiniciando em 3s..." >&2; sleep 3; done'
fi

if [ "${ENABLE_SCHEDULE:-false}" = "true" ] && [ -d "${APP_PATH}/vendor" ]; then
    start_bg "Schedule" bash -c 'while true; do php artisan schedule:run --verbose --no-interaction; sleep 60; done'
fi

if [ "${ENABLE_WORKER:-false}" = "true" ] && [ "${ENABLE_HORIZON:-false}" != "true" ] && [ -d "${APP_PATH}/vendor" ]; then
    start_bg "Queue worker" bash -c 'while true; do php artisan queue:work --sleep=3 --tries=3 --max-time=3600; echo " -----> Warning: queue:work saiu; reiniciando..." >&2; sleep 1; done'
fi

if [ "${#child_pids[@]}" -eq 0 ]; then
    log " -----> Error: no services enabled"
    exit 1
fi

log " -----> Info: All services started. Supervising..."

while true; do
    if [ "${ENABLE_PHPFPM:-true}" = "true" ] && ! fpm_is_alive; then
        log " -----> Error: PHP-FPM saiu (pidfile/socket)."
        exit 1
    fi
    if [ -n "$nginx_pid" ] && ! kill -0 "$nginx_pid" 2>/dev/null; then
        log " -----> Error: NGINX saiu."
        exit 1
    fi
    sleep 2
done
