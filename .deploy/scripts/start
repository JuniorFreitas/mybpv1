#!/bin/bash
# Entrypoint MyBPIN — runtime PHP 8.5 (imagem mybp/php-base)
set -e

COL_GREEN="${COL_GREEN:-\033[0;32m}"
COL_MAGENTA="${COL_MAGENTA:-\033[0;35m}"
COL_RESET="${COL_RESET:-\033[0m}"

APP_PATH="${APP_PATH:-/var/www/html}"
APP_ENV="${APP_ENV:-local}"
PHP_INI_DIR="${PHP_INI_DIR:-/usr/local/etc/php}"
PHP_FPM_POOL_DIR="${PHP_FPM_POOL_DIR:-/usr/local/etc/php-fpm.d}"
SUPERVISOR_DIR="${SUPERVISOR_DIR:-/etc/supervisor/conf.d}"

ENABLE_SCHEDULE="${ENABLE_SCHEDULE:-false}"
ENABLE_WORKER="${ENABLE_WORKER:-false}"
ENABLE_HORIZON="${ENABLE_HORIZON:-false}"
ENABLE_WEBSOCKETS="${ENABLE_WEBSOCKETS:-false}"
ENABLE_CACHE_APP="${ENABLE_CACHE_APP:-false}"
ENABLE_MIGRATE="${ENABLE_MIGRATE:-true}"

cd "$APP_PATH"

printf "${COL_GREEN} -----> Info:${COL_RESET} Runtime PHP $(php -r 'echo PHP_VERSION;') / APP_ENV=${APP_ENV}\n"

# Overlay de conf.d do deploy (não substituir php.ini completo estilo Debian 8.2)
if [ -d "$APP_PATH/.deploy/php/conf.d" ]; then
    printf "${COL_GREEN} -----> Info:${COL_RESET} Applying .deploy/php/conf.d overlays...\n"
    cp -f "$APP_PATH/.deploy/php/conf.d/"*.ini "$PHP_INI_DIR/conf.d/" 2>/dev/null || true
fi

# Mitigação CVE-2026-115560 / CVE-2026-109619
CVE_SESSION_UPLOAD_CONF="$APP_PATH/.deploy/php/fpm-pool.d/zz-cve-2026-115560.conf"
if [ ! -f "$CVE_SESSION_UPLOAD_CONF" ]; then
    # Fallback: conf já bakeada na base
    if [ ! -f "$PHP_FPM_POOL_DIR/zz-cve-2026-115560.conf" ]; then
        printf "${COL_MAGENTA} -----> Error:${COL_RESET} Missing CVE-2026-115560 mitigation conf\n"
        exit 1
    fi
    printf "${COL_GREEN} -----> Info:${COL_RESET} Using base image CVE mitigation conf...\n"
else
    printf "${COL_GREEN} -----> Info:${COL_RESET} Applying PHP session.upload_progress mitigation (CVE-2026-115560)...\n"
    cp "$CVE_SESSION_UPLOAD_CONF" "$PHP_FPM_POOL_DIR/zz-cve-2026-115560.conf"
fi

toggle_supervisor_program() {
    local name="$1"
    local enabled="$2"
    local src="$SUPERVISOR_DIR/${name}.conf.default"
    local dst="$SUPERVISOR_DIR/${name}.conf"
    if [ "$enabled" = "true" ]; then
        if [ ! -f "$src" ]; then
            printf "${COL_MAGENTA} -----> Warning:${COL_RESET} Missing supervisor template ${src}\n"
            return 0
        fi
        printf "${COL_GREEN} -----> Info:${COL_RESET} Enabling supervisor program: ${name}\n"
        cp -f "$src" "$dst"
    else
        rm -f "$dst"
    fi
}

if [ -d "$APP_PATH/vendor" ]; then
    if [ "$ENABLE_MIGRATE" = "true" ] && [ -f "$APP_PATH/artisan" ]; then
        printf "${COL_GREEN} -----> Info:${COL_RESET} Running migrations...\n"
        php "$APP_PATH/artisan" migrate --force

        printf "${COL_GREEN} -----> Info:${COL_RESET} Running HabilidadesTableSeeder...\n"
        php "$APP_PATH/artisan" db:seed --class=HabilidadesTableSeeder --force

        printf "${COL_GREEN} -----> Info:${COL_RESET} Running WhatsappTemplatePadraoSeeder...\n"
        php "$APP_PATH/artisan" db:seed --class=WhatsappTemplatePadraoSeeder --force
    fi

    if [ "$ENABLE_CACHE_APP" = "true" ]; then
        printf "${COL_GREEN} -----> Info:${COL_RESET} Caching package discovery and config...\n"
        php "$APP_PATH/artisan" package:discover --ansi
        php "$APP_PATH/artisan" config:cache
    fi

    toggle_supervisor_program "schedule" "$ENABLE_SCHEDULE"
    toggle_supervisor_program "worker" "$ENABLE_WORKER"
    toggle_supervisor_program "horizon" "$ENABLE_HORIZON"
    toggle_supervisor_program "websockets" "$ENABLE_WEBSOCKETS"
else
    printf "${COL_MAGENTA} -----> Warning:${COL_RESET} Directory ${APP_PATH}/vendor does not yet exist.\n"
    toggle_supervisor_program "schedule" "false"
    toggle_supervisor_program "worker" "false"
    toggle_supervisor_program "horizon" "false"
    toggle_supervisor_program "websockets" "false"
fi

# Nginx + PHP-FPM permanecem sempre ativos (programas da imagem base)
if [ -d "$APP_PATH/storage" ]; then
    printf "${COL_GREEN} -----> Info:${COL_RESET} Fixing permissions on storage...\n"
    chown -R www-data:www-data "$APP_PATH/storage" || true
    chmod -R ug+rwx "$APP_PATH/storage" || true
fi
if [ -d "$APP_PATH/bootstrap/cache" ]; then
    printf "${COL_GREEN} -----> Info:${COL_RESET} Fixing permissions on bootstrap/cache...\n"
    chown -R www-data:www-data "$APP_PATH/bootstrap/cache" || true
    chmod -R ug+rwx "$APP_PATH/bootstrap/cache" || true
fi

printf "${COL_GREEN} -----> Info:${COL_RESET} Launching supervisord...\n"
exec /usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf
